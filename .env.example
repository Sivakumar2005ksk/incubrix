# IncuBrix Environment Configuration Template
# Integration Standard #1 & #6

PORT=8000
HOST=0.0.0.0
DEBUG=false

# Storage Settings (Local or MinIO)
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=incubrix-outputs
S3_REGION=us-east-1

# HMAC Signing Key for Async Webhooks (Integration Standard #3)
WEBHOOK_SECRET_KEY=incubrix-super-secret-hmac-key

# Provider Selection (Zero API keys required by default)
STT_PROVIDER=mock
NLP_PROVIDER=deterministic

# Optional AI LLM Intent Classification (Rule #3: Swappable Provider with Mock default)
# Options: mock | gemini | openai | ollama
LLM_PROVIDER=mock
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-1.5-flash
